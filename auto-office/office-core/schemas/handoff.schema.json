{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:office-core:4.0.0:handoff.schema.json",
  "title": "Executor handoff report",
  "description": "Written to a file at the Kernel's handoff_path. A chat summary is not a handoff: summaries compact, files survive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "work_items",
    "commits",
    "validation",
    "upline",
    "self_review"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "done",
              "partial",
              "blocked",
              "skipped"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "commits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "head"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "log": {
          "type": "string"
        }
      }
    },
    "interfaces_verified": {
      "type": "array",
      "description": "Every hook, callback, event, SDK method, or endpoint touched. Empty is valid only when the diff touches none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "signature",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "description": "Copied from the real definition, not from the brief."
          },
          "source": {
            "type": "string",
            "description": "file:line it was read from."
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "output",
        "passed"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string",
          "description": "Real captured output. A narrated result is not output."
        },
        "passed": {
          "type": "boolean"
        },
        "ran_against": {
          "type": "string",
          "description": "Commit the gate ran against. Output that cannot be tied to a HEAD proves nothing about it."
        }
      }
    },
    "mutation_table": {
      "type": "array",
      "description": "One row per new or amended test. Rows map 1:1 to tests; a test with no row is unverified.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test",
          "mutation",
          "went_red"
        ],
        "properties": {
          "test": {
            "type": "string"
          },
          "mutation": {
            "type": "string",
            "description": "What was broken to make it fail."
          },
          "went_red": {
            "type": "boolean"
          }
        }
      }
    },
    "tester_report": {
      "type": "object",
      "description": "Optional summary of an Executor-owned Tester worker. The full report follows tester-report.schema.json.",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "base",
        "checkpoint",
        "next_action"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL_IMPLEMENTATION",
            "FAIL_TEST",
            "BLOCKED_ENV",
            "SPEC_AMBIGUITY"
          ]
        },
        "base": {
          "type": "string"
        },
        "checkpoint": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "unrequested_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files created that no work item asked for. Front-run stubs get deleted now, not rediscovered three tasks later."
    },
    "live_writes": {
      "type": "array",
      "description": "Anything written to a live system. Each needs a read-back, not an exit code.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "readback"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "readback": {
            "type": "string"
          },
          "matches_source": {
            "type": "boolean"
          }
        }
      }
    },
    "self_review": {
      "type": "object",
      "description": "The executor's own review of its own work: per work item before it is marked done, and once over the cumulative BASE..HEAD diff at Finish. Required. Never substitutes for the code-review gate, and its findings are not copied into the reviewer's brief.",
      "additionalProperties": false,
      "required": [
        "per_task_done",
        "cumulative_done",
        "findings"
      ],
      "properties": {
        "per_task_done": {
          "type": "boolean",
          "description": "Every work item received a spec-compliance and a quality verdict before being marked done, including work the executor implemented inline."
        },
        "cumulative_done": {
          "type": "boolean",
          "description": "A whole-run pass over BASE..HEAD was performed after the gate went green."
        },
        "findings": {
          "type": "array",
          "description": "An empty array is valid; an absent section is not.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grade",
              "summary",
              "disposition"
            ],
            "properties": {
              "grade": {
                "enum": [
                  "critical",
                  "important",
                  "minor"
                ]
              },
              "summary": {
                "type": "string"
              },
              "disposition": {
                "enum": [
                  "fixed",
                  "deferred",
                  "parked"
                ]
              },
              "commit": {
                "type": "string",
                "description": "Expected when disposition is \"fixed\"."
              },
              "ruling": {
                "type": "string",
                "description": "Why the code stands, when disposition is \"parked\"."
              }
            }
          }
        }
      }
    },
    "upline": {
      "type": "array",
      "description": "Every unresolved or self-resolved question. Empty means genuinely none, and the planner checks that against the diff.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "item"
        ],
        "properties": {
          "label": {
            "enum": [
              "needs-planner",
              "needs-user",
              "decided"
            ]
          },
          "item": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "requirements_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Frozen by the planner at the end of interactive discovery. Bumped by a requirements amendment."
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped by a plan-contract change; a routing or requirements change alone does not move it."
    },
    "routing_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped by a routing-only amendment; forces no other bump and never wakes the planner."
    },
    "landing_packet": {
      "type": "object",
      "additionalProperties": false,
      "description": "The compact record that travels UP to the orchestrator instead of the executor's transcript. It points at this handoff, the review files, and the PR for anything deeper.",
      "required": [
        "family_id",
        "executor",
        "status",
        "requirements_version",
        "plan_version",
        "routing_version",
        "change_summary",
        "validation",
        "review_mode"
      ],
      "properties": {
        "family_id": {
          "type": "string"
        },
        "executor": {
          "type": "string",
          "description": "Executor id and its declared scope."
        },
        "status": {
          "enum": [
            "landed",
            "blocked",
            "true_conflict"
          ]
        },
        "requirements_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Frozen by the planner at the end of interactive discovery. Bumped by a requirements amendment."
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Bumped by a plan-contract change; a routing or requirements change alone does not move it."
        },
        "routing_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Bumped by a routing-only amendment; forces no other bump and never wakes the planner."
        },
        "tasks_completed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "change_summary": {
          "type": "string",
          "description": "A few lines. Not a diff, not a transcript."
        },
        "interfaces_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "name \u2014 file:line"
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "result"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "description": "Real output. An exit code is not evidence."
              }
            }
          }
        },
        "review_mode": {
          "enum": [
            "inline",
            "adversarial"
          ],
          "description": "inline is legal only when all five lines of core's inline-eligibility test pass."
        },
        "review_rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "dispositions"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "dispositions": {
                "type": "array",
                "items": {
                  "enum": [
                    "accepted_fixed",
                    "rejected_with_evidence",
                    "unresolved"
                  ]
                }
              }
            }
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Plan deviation with rationale and the amendment commit hash."
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "PR, commit range, or artifact path."
          }
        },
        "downstream_impacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
