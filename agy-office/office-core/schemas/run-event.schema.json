{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:office-core:3.0.0:run-event.schema.json",
  "title": "Office run event",
  "description": "Emitted at explicit command dispatch. A transcript keyword match is a catalog mention, not an invocation, and never produces one of these. Stores counts and redacted labels only: no user prompts, secrets, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "invocation_id", "plugin", "core_version", "timestamp"],
  "properties": {
    "event": {
      "enum": [
        "office.invoked",
        "plan.approved",
        "packet.built",
        "worker.dispatched",
        "worker.completed",
        "tester.dispatched",
        "tester.checkpoint",
        "tester.result",
        "tester.completed",
        "verification.completed",
        "review.round",
        "review.verdict",
        "closeout.completed",
        "run.aborted"
      ]
    },
    "invocation_id": { "type": "string" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["codex-office", "claude-office", "agy-office"] },
        "version": { "type": "string" }
      }
    },
    "core_version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "role": { "enum": ["planner", "executor", "verifier", "reviewer"] },
    "worker_kind": {
      "enum": ["implementer", "tester"],
      "description": "Optional Executor-owned worker specialization; tester events retain role=executor."
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["test-first", "implementation-first", "hybrid"] },
        "state": {
          "enum": ["planned", "authoring", "ready_for_checkpoint", "running", "result_reported", "executor_fixing", "retest_eligible", "pass", "escalated"]
        },
        "status": {
          "enum": ["PASS", "FAIL_IMPLEMENTATION", "FAIL_TEST", "BLOCKED_ENV", "SPEC_AMBIGUITY"]
        },
        "base": { "type": "string" },
        "checkpoint": { "type": "string" },
        "command": { "type": "string" },
        "live_result": { "type": "boolean" },
        "stable_result": { "type": "boolean" },
        "correction_round": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "dispatch_mode": {
      "type": "string",
      "description": "Office-specific: codex-exec, claude-cli, claude-in-session, agy-print, herdr, inline."
    },
    "selected_spokes": { "type": "array", "items": { "type": "string" } },
    "capability_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offered": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "budget_state": { "enum": ["within", "warning", "over"] }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launch_id": { "type": "string" },
        "session_id": { "type": "string" },
        "worktree_id": { "type": "string", "description": "Identity, not a display label. Duplicate-writer detection compares this." },
        "forked_from": { "type": "string" },
        "fork_reason": { "enum": ["question", "recovery", "steering", "quota", "stall"] }
      }
    },
    "brand": {
      "enum": ["codex", "claude", "agy"],
      "description": "Which tool family filled this role. Distinct from model: a brand is routed by fit, a model is fixed by the office's role table."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "effort": { "type": "string" }
      }
    },
    "effort": {
      "type": "string",
      "description": "Effort level for this dispatch. Duplicates model.effort at the top level so a cost retrospective can read model and effort without unwrapping; emit both consistently or neither."
    },
    "dispatch_form": {
      "enum": ["cli", "in-session", "herdr", "inline"],
      "description": "How the work was dispatched, not how expensive it was. When HERDR_ENV=1, delegated work uses a visible Herdr pane; otherwise the office's normal brand-routing rule applies. Work the delegation test says buys nothing is inline."
    },
    "review_rounds": {
      "type": "integer",
      "minimum": 0,
      "description": "Code-review rounds consumed by this task. PLAN DEFECT and BRIEF DEFECT consume none."
    },
    "plan_review_rounds": {
      "type": "integer",
      "minimum": 0,
      "description": "Plan-review passes for this run. A plan-review gate runs once; a value above 1 means the office looped a gate that was specified not to."
    },
    "brief_defects": {
      "type": "integer",
      "minimum": 0,
      "description": "BRIEF DEFECT returns raised on this task by its executor."
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0,
      "description": "Output tokens, only where the harness actually reports them. Omit the field when unavailable — never emit 0, which reads as a measurement."
    },
    "wall_clock_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock seconds for this dispatch. A first-class cost: a silent dispatch costs the run its wall clock whether or not it burned a token."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 5 },
        "verdict": { "enum": ["APPROVED", "CHANGES REQUIRED", "PLAN DEFECT"] },
        "findings": { "type": "integer", "minimum": 0 },
        "continuity_preserved": { "type": "boolean" }
      }
    },
    "evidence_state": { "enum": ["complete", "partial", "missing", "unverified"] },
    "outcome": { "enum": ["approved", "deadlocked", "aborted", "rolled-back", "in-progress"] },
    "duration_ms": { "type": "integer", "minimum": 0 }
  }
}
