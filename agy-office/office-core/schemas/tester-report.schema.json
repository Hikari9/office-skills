{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:office-core:7.0.0:tester-report.schema.json",
  "title": "Tester worker result report",
  "description": "File-based report from an Executor-owned Tester worker. It is evidence, not an approval gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "parent_invocation_id", "task_id", "worker_kind", "mode", "state", "status", "base", "commands", "results", "mutation_table", "upline", "self_review"],
  "properties": {
    "invocation_id": { "type": "string" },
    "parent_invocation_id": { "type": "string" },
    "task_id": { "type": "string" },
    "worker_kind": { "const": "tester" },
    "mode": { "enum": ["test-first", "implementation-first", "hybrid"] },
    "state": { "enum": ["planned", "authoring", "ready_for_checkpoint", "running", "result_reported", "executor_fixing", "retest_eligible", "pass", "escalated"] },
    "status": { "enum": ["PASS", "FAIL_IMPLEMENTATION", "FAIL_TEST", "BLOCKED_ENV", "SPEC_AMBIGUITY"] },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "worktree"],
      "properties": {
        "commit": { "type": "string" },
        "worktree": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "executor_commit": { "type": "string" },
        "tester_commit": { "type": "string" },
        "worktree": { "type": "string" }
      }
    },
    "owned_paths": { "type": "array", "items": { "type": "string" } },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "ran_against", "output_path"],
        "properties": {
          "command": { "type": "string" },
          "ran_against": { "type": "string" },
          "output_path": { "type": "string" },
          "live": { "type": "boolean" },
          "stable": { "type": "boolean" },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "results": { "type": "string" },
    "mutation_table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "mutation", "went_red"],
        "properties": {
          "test": { "type": "string" },
          "mutation": { "type": "string" },
          "went_red": { "type": "boolean" }
        }
      }
    },
    "correction_round": { "type": "integer", "minimum": 0, "maximum": 2 },
    "next_action": { "type": "string" },
    "upline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "item"],
        "properties": {
          "label": { "enum": ["needs-planner", "needs-user", "decided"] },
          "item": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "self_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["done", "findings"],
      "properties": {
        "done": { "type": "boolean" },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
