{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:office-core:1.2.0:handoff.schema.json",
  "title": "Executor handoff report",
  "description": "Written to a file at the Kernel's handoff_path. A chat summary is not a handoff: summaries compact, files survive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "work_items", "commits", "validation", "upline"],
  "properties": {
    "invocation_id": { "type": "string" },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "files"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["done", "partial", "blocked", "skipped"] },
          "files": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "commits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "base": { "type": "string" },
        "head": { "type": "string" },
        "log": { "type": "string" }
      }
    },
    "interfaces_verified": {
      "type": "array",
      "description": "Every hook, callback, event, SDK method, or endpoint touched. Empty is valid only when the diff touches none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "source"],
        "properties": {
          "name": { "type": "string" },
          "signature": { "type": "string", "description": "Copied from the real definition, not from the brief." },
          "source": { "type": "string", "description": "file:line it was read from." }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output", "passed"],
      "properties": {
        "command": { "type": "string" },
        "output": { "type": "string", "description": "Real captured output. A narrated result is not output." },
        "passed": { "type": "boolean" },
        "ran_against": { "type": "string", "description": "Commit the gate ran against. Output that cannot be tied to a HEAD proves nothing about it." }
      }
    },
    "mutation_table": {
      "type": "array",
      "description": "One row per new or amended test. Rows map 1:1 to tests; a test with no row is unverified.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "mutation", "went_red"],
        "properties": {
          "test": { "type": "string" },
          "mutation": { "type": "string", "description": "What was broken to make it fail." },
          "went_red": { "type": "boolean" }
        }
      }
    },
    "unrequested_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files created that no work item asked for. Front-run stubs get deleted now, not rediscovered three tasks later."
    },
    "live_writes": {
      "type": "array",
      "description": "Anything written to a live system. Each needs a read-back, not an exit code.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "readback"],
        "properties": {
          "target": { "type": "string" },
          "readback": { "type": "string" },
          "matches_source": { "type": "boolean" }
        }
      }
    },
    "upline": {
      "type": "array",
      "description": "Every unresolved or self-resolved question. Empty means genuinely none, and the planner checks that against the diff.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "item"],
        "properties": {
          "label": { "enum": ["needs-planner", "needs-user", "decided"] },
          "item": { "type": "string" },
          "rationale": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
